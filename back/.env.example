# PORT é o que src/server.js efetivamente usa hoje. API_PORT/API_HOST já são lidos por
# src/config/env.js, mas ainda não estão conectados a server.js — fora do escopo desta
# etapa (modelagem de banco); mantidos documentados para quando essa ligação for feita.
PORT=3000
API_PORT=3000
API_HOST=0.0.0.0

GEMINI_API_KEY=

# Auth.js (ADR 0003) — segredo compartilhado para validação de sessão no backend.
AUTH_SECRET=

# PostgreSQL (ADR 0003 / ADR 0004) — únicas variáveis aceitas para conexão com o banco.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=pollen_parque
POSTGRES_USERNAME=pollen_parque
POSTGRES_PASSWORD=pollen_parque
POSTGRES_SCHEMA=public
