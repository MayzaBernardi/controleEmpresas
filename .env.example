# Variáveis usadas pelo próprio docker-compose.yml (interpolação `${VAR}` no arquivo, não
# o runtime dos containers — cada serviço tem seu próprio env_file: back/.env, front usa
# build args). Copie para `.env` na raiz do repo antes de rodar `docker compose up --build`.

# URL pública onde a API (back/) vai ficar acessível PARA O NAVEGADOR do usuário depois do
# deploy — embutida no bundle do front em tempo de build (docker-compose.yml -> front.build.args).
# NUNCA localhost aqui num deploy real: precisa ser o domínio/IP público do back.
# Ex.: https://api.pollenparque.org.br ou http://SEU_SERVIDOR:3001
NEXT_PUBLIC_API_URL=
